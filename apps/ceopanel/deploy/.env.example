# Native ERP discovery, reports and external MCP need no model API key.
ERP_AI_READ_ENABLED=false
ERP_AI_READ_ROLES=Desk User,System Manager
FRAPPE_OAUTH_CLIENT_ID=
FRAPPE_OAUTH_CLIENT_SECRET=
FRAPPE_OAUTH_SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
ERPNEXT_WEBHOOK_SECRET=
ERPNEXT_RECEIPT_SECRET=
MCP_EXTERNAL_ENABLED=false
MCP_AUTH_SECRET=
MCP_CLIENT_ORIGINS=
