PUBLIC_HOST=ceo.example.com
POSTGRES_PASSWORD=replace-with-a-unique-long-password
CEOPANEL_ORIGIN=https://ceo.example.com
# The production server always requires native ERP sign-in.
CEOPANEL_DISABLE_AUTH=false
