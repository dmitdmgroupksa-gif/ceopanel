# Server configuration. No credentials are placed in the browser bundle.
ERPNEXT_URL=https://dmgroup.frappe.cloud
COMPANY_NAME=Durar Masagh
BUSINESS_TIMEZONE=Asia/Riyadh
# Optional: exact ERPNext Company document name to select by default.
ERPNEXT_COMPANY=Durar Masagh Trading Company
# Set this to the public origin when hosted behind a reverse proxy.
# CEOPANEL_ORIGIN=https://ceo.your-company.com

# Optional local UI testing without sign-in (next dev + loopback hosts only).
# Live ERP/API access still requires a real session. Ignored in production.
CEOPANEL_DISABLE_AUTH=false

# Use a staging clone before validating adapters. Never commit the populated file.
PLATFORM_CONFIG_PATH=
DATABASE_URL=
# Optional localhost-only database: deploy/compose.local.yaml (port 55432).
CEOPANEL_LOCAL_DB_PASSWORD=
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# ERP-wide read-only assistant tools. Native ERP role/record/report/print/export
# permissions still apply. Enables approved business data processing by AI.
# External clients must separately consent to ceopanel:erp-read.
ERP_AI_READ_ENABLED=false
# Internal ERP users retain their own native row, field and report permissions.
ERP_AI_READ_ROLES=Desk User,System Manager

# Optional native Frappe login. Register the OAuth Client as described in deploy/FRAPPE-OAUTH.md.
FRAPPE_OAUTH_CLIENT_ID=
FRAPPE_OAUTH_CLIENT_SECRET=
# Optional separate 64-hex encryption key; defaults to MCP_AUTH_SECRET.
FRAPPE_OAUTH_SESSION_SECRET=
OPENAI_EMBEDDING_MODEL=
DOCUMENT_STORAGE_PATH=.private-documents
ERPNEXT_WEBHOOK_SECRET=
ERPNEXT_RECEIPT_SECRET=
# Activate channels only after staging and verified contact mapping.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=

# Internal MCP works without external access. Enable remote clients after staging validation.
MCP_EXTERNAL_ENABLED=false
# Generate 32 random bytes as 64 hex characters; store server-side. Rotation revokes all tokens.
MCP_AUTH_SECRET=
# Optional exact HTTPS browser-client origins, comma-separated. Native clients need no Origin.
MCP_CLIENT_ORIGINS=
# Emergency kill switches: erp,reports,proposals,knowledge,communications,platform,external
MCP_DISABLED_PLUGINS=
