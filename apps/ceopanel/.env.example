# Server configuration. No credentials are placed in the browser bundle.
ERPNEXT_URL=https://dmgroup.frappe.cloud
COMPANY_NAME=Durar Masagh
BUSINESS_TIMEZONE=Asia/Riyadh
# Optional: exact ERPNext Company document name to select by default.
ERPNEXT_COMPANY=
# Set this to the public origin when hosted behind a reverse proxy.
# CEOPANEL_ORIGIN=https://ceo.your-company.com

# Use a staging clone before validating adapters. Never commit the populated file.
PLATFORM_CONFIG_PATH=
DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
DOCUMENT_STORAGE_PATH=.private-documents
ERPNEXT_WEBHOOK_SECRET=
ERPNEXT_RECEIPT_SECRET=
# Activate channels only after staging and verified contact mapping.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=
